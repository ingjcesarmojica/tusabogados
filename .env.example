# TusAbogados.com - Variables de Entorno
# Copiar a .env y completar los valores

# ── LLM principal (OpenRouter / MiMo V2.5) ─────────────────────────
LLM_PROVIDER=openrouter
LLM_MODEL=xiaomi/mimo-v2.5
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
OPENROUTER_MODEL=xiaomi/mimo-v2.5

# ── Gemini AI (fallback) ─────────────────────────────────────────────
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ── Pinecone (RAG) ──────────────────────────────────────────────────
PINECONE_API_KEY=tu_pinecone_api_key_aqui

# ── Supabase (Base de datos) ────────────────────────────────────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_key_aqui

# ── Nombre del Agente IA ──────────────────────────────────────────
AGENTE_NOMBRE=Claudia García

# ── TTS ─────────────────────────────────────────────────────────────
TTS_VOICE=es-US-PalomaNeural

# ── Servidor ────────────────────────────────────────────────────────
PORT=5000

# ── Correo electronico (Resend API) ─────────────────────────────────
# IMPORTANTE: Para evitar spam, debes verificar tu dominio en Resend
# y usar tu propio dominio en RESEND_FROM (no el de resend.dev)
# Guia: https://resend.com/domains
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_tu_api_key_aqui
RESEND_FROM=TusAbogados.com <notificaciones@tusabogados.com>

# ── Agente de Voz (URL base) ───────────────────────────────────────
AGENTE_VOZ_BASE_URL=https://agentcall-et3l.onrender.com/

# ── WhatsApp API (opcional) ────────────────────────────────────────
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ── Recordatorio ────────────────────────────────────────────────────
MINUTOS_RECORDATORIO=15
