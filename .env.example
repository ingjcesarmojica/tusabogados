# TusAbogados.com - Variables de Entorno
# Copiar a .env y completar los valores

# ── LLM principal (OpenRouter / MiMo V2.5) ─────────────────────────
LLM_PROVIDER=openrouter
LLM_MODEL=xiaomi/mimo-v2.5
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
OPENROUTER_MODEL=xiaomi/mimo-v2.5

# ── Gemini AI (fallback) ─────────────────────────────────────────────
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ── Pinecone (RAG) ──────────────────────────────────────────────────
PINECONE_API_KEY=tu_pinecone_api_key_aqui

# ── Supabase (Base de datos) ────────────────────────────────────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_key_aqui

# ── TTS ─────────────────────────────────────────────────────────────
TTS_VOICE=es-US-PalomaNeural

# ── Servidor ────────────────────────────────────────────────────────
PORT=5000

# ── SMTP (Correos electrónicos) ────────────────────────────────────
SMTP_HOST=tu_smtp_host
SMTP_PORT=587
SMTP_USER=tu_correo@tudominio.com
SMTP_PASSWORD=tu_contraseña_smtp
SMTP_FROM_NAME=TusAbogados.com
SMTP_USE_TLS=true

# ── Agente de Voz (URL base) ───────────────────────────────────────
AGENTE_VOZ_BASE_URL=https://agentcall-rkz3.onrender.com/

# ── WhatsApp API (opcional) ────────────────────────────────────────
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ── Recordatorio ────────────────────────────────────────────────────
MINUTOS_RECORDATORIO=15
